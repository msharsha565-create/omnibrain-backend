# Copy to .env and fill in. Never commit real values.

# Required. At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=

# Required: PostgreSQL connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/omnibrain
SPRING_DATASOURCE_USERNAME=omnibrain
SPRING_DATASOURCE_PASSWORD=

# Optional
PORT=8080
ADMIN_USERS=               # comma-separated usernames allowed to call /admin/**
OPENAI_API_KEY=            # unset = the canned "mock" provider answers /api/ai/chat
JWT_TTL_MINUTES=60
JPA_SHOW_SQL=false
