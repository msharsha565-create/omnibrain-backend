# Copy to .env and fill in. Never commit real values.

# Required. At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=

# Required: PostgreSQL connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/omnibrain
SPRING_DATASOURCE_USERNAME=omnibrain
SPRING_DATASOURCE_PASSWORD=

# Optional
PORT=8080
ADMIN_USERS=               # comma-separated usernames allowed to call /admin/**
OPENAI_API_KEY=            # unset = the canned "mock" provider answers /api/ai/chat
JWT_TTL_MINUTES=60
JPA_SHOW_SQL=false

# RAG (all optional)
EMBEDDINGS_PROVIDER=hashing   # hashing (offline, lexical) or openai (semantic, needs a key)
EMBEDDINGS_BASE_URL=          # default https://api.openai.com/v1 (also Gemini/Ollama/vLLM compatible endpoints)
EMBEDDINGS_MODEL=             # default text-embedding-3-small
EMBEDDINGS_API_KEY=           # defaults to OPENAI_API_KEY
RAG_ANSWERER=extractive       # extractive (quotes your documents) or llm (needs OPENAI_API_KEY)
OPENAI_BASE_URL=              # default https://api.openai.com/v1
OPENAI_MODEL=                 # default gpt-4o-mini

